# ==============================================================================
# PROJECTIFY — KUBERNETES SECRETS (TEMPLATE EXAMPLE)
# ==============================================================================
#
# PURPOSE:
#   Template example for Kubernetes secrets.
#   Copy this file to "secrets.yaml" and populate with your production credentials.
# ==============================================================================

apiVersion: v1
kind: Secret
metadata:
  name: projectify-secrets
  namespace: default
  labels:
    app.kubernetes.io/name: projectify
    app.kubernetes.io/part-of: projectify-platform
type: Opaque
stringData:
  DATABASE_URL: "postgresql://username:password@rds_host:5432/projectify?schema=public"
  DIRECT_URL: "postgresql://username:password@rds_host:5432/projectify?schema=public"
  REDIS_URL: "redis://redis_host:6379"

  NEXTAUTH_SECRET: "your_nextauth_secret_key_minimum_32_characters_long"
  NEXTAUTH_URL: "http://localhost:3000"

  COHERE_API_KEY: "your_cohere_api_key"
  PINECONE_API_KEY: "your_pinecone_api_key"
  PINECONE_ENVIRONMENT: "us-east-1"
  PINECONE_INDEX_NAME: "projectify-index"

  R2_ACCOUNT_ID: "your_cloudflare_r2_account_id"
  R2_ACCESS_KEY_ID: "your_cloudflare_r2_access_key"
  R2_SECRET_ACCESS_KEY: "your_cloudflare_r2_secret_key"
  R2_BUCKET_NAME: "projectify-uploads"
  R2_PUBLIC_DOMAIN: "https://pub-xxxx.r2.dev"

  CHAT_ENCRYPTION_KEY: "your_32_character_chat_encryption_secret_key"
